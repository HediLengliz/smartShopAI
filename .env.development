# IntelliCart Development Environment Configuration
# This file is configured for local development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB connection string - Local development
MONGODB_URI=mongodb://localhost:27017/intellicart

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port
PORT=5000

# Node environment
NODE_ENV=development

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================

# Session secret for express-session
SESSION_SECRET=dev-secret-change-in-production-12345678

# ============================================================================
# AI SERVICE CONFIGURATION (Optional - Mock mode enabled)
# ============================================================================

# OpenAI API Key (optional for development)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face API Key (optional)
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable AI features (using mock implementations)
ENABLE_AI_FEATURES=true

# Enable NLP parsing (mock mode)
ENABLE_NLP_PARSING=true

# Enable recommendations (mock mode)
ENABLE_RECOMMENDATIONS=true

# Enable chatbot (mock mode)
ENABLE_CHATBOT=true

# Enable analytics
ENABLE_ANALYTICS=false

# Mock AI responses for development (true = no API keys needed)
MOCK_AI_RESPONSES=true

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

# Enable debug mode
DEBUG=true

# Enable API documentation
ENABLE_API_DOCS=true

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# CORS origins for development
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level
LOG_LEVEL=debug
