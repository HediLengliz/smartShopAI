# IntelliCart Environment Configuration
# Copy this file to .env and update the values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB connection string
# For local development: mongodb://localhost:27017/intellicart
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/intellicart
MONGODB_URI=mongodb://localhost:27017/intellicart

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port (default: 5000)
PORT=5000

# Node environment (development, production)
NODE_ENV=development

# ============================================================================
# AI SERVICE CONFIGURATION (Optional)
# ============================================================================

# OpenAI API Key (for GPT-4, GPT-3.5-turbo integration)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (for Claude integration)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face API Key (for transformer models)
# Get your API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================

# Session secret for express-session
# Generate a random string for production
SESSION_SECRET=your_session_secret_here

# ============================================================================
# PAYMENT CONFIGURATION (Optional)
# ============================================================================

# Stripe API Keys (for payment processing)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# PayPal Configuration (for PayPal payments)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ============================================================================
# REDIS CONFIGURATION (Optional)
# ============================================================================

# Redis URL for caching and session storage
# For local development: redis://localhost:6379
# For production: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable AI features
ENABLE_AI_FEATURES=true

# Enable NLP parsing
ENABLE_NLP_PARSING=true

# Enable recommendations
ENABLE_RECOMMENDATIONS=true

# Enable chatbot
ENABLE_CHATBOT=true

# Enable analytics
ENABLE_ANALYTICS=false

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

# Enable debug mode
DEBUG=false

# Enable API documentation
ENABLE_API_DOCS=true

# Mock AI responses (for development)
MOCK_AI_RESPONSES=true
